{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":prHourlyLimit2",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly",
    "security:minimumReleaseAgeNpm"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Paris",
  "ignorePaths": ["**/dist/**"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Default ModularGuard version shipped by the action, and its mentions in the README",
      "managerFilePatterns": ["/^action\\.yaml$/", "/^README\\.md$/"],
      "matchStrings": [
        "# renovate: modularguard\\s+default: '(?<currentValue>[^']+)'",
        "\\| `modularguard-version`\\s+\\| No\\s+\\| `(?<currentValue>[^`]+)`",
        "modularguard-version: '(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "depNameTemplate": "n2jsoft-public-org/ModularGuard",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "The action runs on node24 (action.yaml), so keep Node and its types on that major",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "ncc (the dist bundler) does not support TypeScript 7 (native compiler) yet: stay below 7 until it does",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Group all GitHub Actions bumps into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Auto-merge non-major updates once required CI checks pass: Renovate merges them itself, after rebasing and retesting, with its bypass of the review required by the PR ruleset",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "ModularGuard is still 0.x, where any bump can change the JSON output the action parses, and CI does not run the real binary: review those PRs by hand",
      "matchDepNames": ["n2jsoft-public-org/ModularGuard"],
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    }
  ]
}
